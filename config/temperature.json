{
  "$schema_comment": "EXECUTION_ENGINE TEMPERATURE_CONTROL - 温度控制参数表 (架构模块3)",
  "version": "0.1.0",
  "temperature_range": [0.1, 1.0],
  "default": 0.5,
  "semantics": {
    "low": "T=0.1 低容忍度: 苛刻触发(多因子共振)、严格止损(0.5 ATR)、最小头寸; 适用于高波动/不明朗市场",
    "high": "T=1.0 高容忍度: 宽松触发(单因子突破)、宽幅止损(2.0 ATR)、最大头寸; 适用于强趋势市场"
  },
  "interpolation": {
    "method": "linear",
    "note": "0.1..1.0 之间所有参数线性插值"
  },
  "parameter_maps": {
    "signal": {
      "factor_resonance_min": { "T0.1": 3, "T1.0": 1, "unit": "因子共振数量下限" },
      "spring_confirm_bars": { "T0.1": 3, "T1.0": 1, "unit": "Spring确认K线数" },
      "breakout_confirm_pct": { "T0.1": 1.0, "T1.0": 0.2, "unit": "突破确认幅度(%)" },
      "vsa_climax_confirm": { "T0.1": true, "T1.0": false, "unit": "VSA高潮放量确认要求" }
    },
    "risk": {
      "stop_atr_mult": { "T0.1": 0.5, "T1.0": 2.0, "unit": "ATR倍数止损" },
      "take_profit_rr": { "T0.1": 3.0, "T1.0": 1.5, "unit": "盈亏比目标" },
      "position_pct": { "T0.1": 0.05, "T1.0": 0.25, "unit": "单笔头寸占净值比例" },
      "max_positions": { "T0.1": 2, "T1.0": 6, "unit": "最大并行持仓数" },
      "daily_loss_limit_pct": { "T0.1": 1.5, "T1.0": 3.0, "unit": "日亏损熔断" }
    },
    "filters": {
      "regime_quality_min": { "T0.1": 0.7, "T1.0": 0.4, "unit": "趋势环境质量分下限" },
      "volume_zscore_min": { "T0.1": 1.5, "T1.0": 0.5, "unit": "成交量Z-score下限" },
      "volatility_band": { "T0.1": [0.5, 2.0], "T1.0": [0.3, 3.0], "unit": "ATR%可接受区间" }
    }
  }
}
